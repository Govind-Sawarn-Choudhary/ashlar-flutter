{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (live API)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define-from-file=env.production.json"
      ]
    },
    {
      "name": "Flutter (local backend emulator)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
      ]
    }
  ]
}
